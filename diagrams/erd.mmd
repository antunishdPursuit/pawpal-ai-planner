erDiagram
    OWNER ||--o{ PET : owns
    PET ||--o{ TASK : has
    TASK ||--o| SCHEDULE : repeats_with
    OWNER {
        int owner_id PK
        string name
        string timezone
    }
    PET {
        int pet_id PK
        int owner_id FK
        string name
        string species
        int age
    }
    TASK {
        int task_id PK
        int pet_id FK
        string title
        string description
        date one_off_due_date
        time time_of_day
        date last_completed_date
        string location_text
        string creation_request_id UK
    }
    SCHEDULE {
        int task_id PK, FK
        string schedule_type
        date start_date
        int interval_days
        date next_due_date
    }
